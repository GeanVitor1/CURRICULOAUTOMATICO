HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Na Vercel (Production): APP_ORIGIN=https://seu-dominio.vercel.app
NODE_ENV=development
# Google Cloud: cliente OAuth do tipo Aplicativo da Web (credenciais somente no servidor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vazio usa automaticamente APP_ORIGIN + /api/auth/google/callback.
# Cadastre essa URL exata no cliente OAuth Web do Google Cloud.
GOOGLE_REDIRECT_URI=
# Stripe Billing: chaves privadas, nunca use variáveis VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# Para manter o domínio Vercel com API permanente, configure na Vercel:
# API_UPSTREAM_ORIGIN=https://seu-backend.onrender.com
# API_PROXY_SECRET=mesmo-segredo-privado-na-vercel-e-no-backend
# Consulte docs/CONFIGURACAO-PUBLICA.md para produtos, webhook e portal do cliente.
# Omit DATABASE_URL for the embedded persistent PostgreSQL-compatible local engine.
# For production and separate workers, PostgreSQL and Redis are required.
# DATABASE_URL=postgres://orbita:change-me@localhost:5432/orbita
# REDIS_URL=redis://localhost:6379
DATA_DIR=.data
# Native candidate sessions use a headless Chromium browser on the API and worker.
# Install: npx playwright install --with-deps chromium
# API and workers must share DATA_DIR and ENCRYPTION_KEY for resumes and encrypted sessions.
# Run Linux services as an unprivileged user with browser sandbox support.
PORTAL_CONNECTIONS_ENABLED=true
# Opcional: caminho absoluto de um Chromium/Chrome compatível instalado no servidor.
# PORTAL_BROWSER_EXECUTABLE_PATH=
# Enable only providers with explicit permission from the service for browser access.
# A candidate's consent alone does not grant that permission. Default: none.
PORTAL_BROWSER_AUTHORIZED=
# LinkedIn public-page automation also requires provider authorization.
PORTAL_DISCOVERY_AUTHORIZED=
# Official LinkedIn OpenID Connect: identity only, no job/application permission.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:5173/api/oauth/linkedin/callback
PORTAL_LOGIN_LIMIT=4
# Encryption master key: optional base64 32 bytes. Otherwise .data/encryption.key is generated.
# Keep this key private and back it up independently from the database.
# ENCRYPTION_KEY=
# Na Vercel, DATABASE_URL (PostgreSQL) e ENCRYPTION_KEY fixa são obrigatórios.
# Instruções de publicação: docs/VERCEL-E-GOOGLE.md
# Ollama endpoint is configured only on the server, never by arbitrary frontend URLs.
# OLLAMA_URL=http://127.0.0.1:11434
# Optional authorized employer-controlled application adapter (never portal passwords).
# APPLICATION_WEBHOOK_URL=https://your-authorized-service.example/applications
# APPLICATION_WEBHOOK_TOKEN=
# APPLICATION_WEBHOOK_AUTHORIZED=true
# APPLICATION_WEBHOOK_PORTALS=linkedin,gupy,glassdoor,infojobs
# Declare only portals the authorized service can submit to on behalf of connected users.
# Each request includes workspaceId, portal and the approved original resume file as base64.
# Adapter must accept Idempotency-Key and return { status: "sent", receipt: "..." }.

# Gemini: server-only credential, never VITE_* or source code.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Each user must opt in to external analysis in Settings; local analysis remains available.

# Optional Adzuna. Enable only countries covered by your valid API license.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=br
# ADZUNA_ALLOWED_COUNTRIES=br
