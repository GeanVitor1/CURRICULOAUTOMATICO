{
  "manifest_version": 3,
  "name": "EmpreGatos ? Conectar portais",
  "version": "1.0.0",
  "description": "Conecta uma sess?o de candidato ? automa??o, somente ap?s autoriza??o expl?cita.",
  "key": "",
  "permissions": [],
  "optional_permissions": ["cookies", "scripting"],
  "optional_host_permissions": [
    "https://*.gupy.io/*",
    "https://*.infojobs.com.br/*",
