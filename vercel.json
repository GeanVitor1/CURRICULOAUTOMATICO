{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.mjs": {
      "includeFiles": "migrations/**",
      "maxDuration": 60
    },
    "api/search-worker.mjs": {
      "includeFiles": "migrations/**",
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "empregatos-discovery",
          "retryAfterSeconds": 420
        }
      ]
    },
    "api/daily-routine.mjs": {
      "includeFiles": "migrations/**",
      "maxDuration": 300
    }
  },
  "crons": [{ "path": "/api/daily-routine", "schedule": "0 11 * * *" }],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    { "src": "/api/search-worker", "dest": "/api/search-worker" },
    { "src": "/api/daily-routine", "dest": "/api/daily-routine" },
    { "src": "/api(?:/.*)?", "dest": "/api/server" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
