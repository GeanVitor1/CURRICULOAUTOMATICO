HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Na Vercel (Production): APP_ORIGIN=https://seu-dominio.vercel.app
NODE_ENV=development
# Google Cloud: cliente OAuth do tipo Aplicativo da Web (credenciais somente no servidor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vazio usa automaticamente APP_ORIGIN + /api/auth/google/callback.
# Cadastre essa URL exata no cliente OAuth Web do Google Cloud.
GOOGLE_REDIRECT_URI=
# Stripe Billing: chaves privadas, nunca use variáveis VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PORTAL_CONFIGURATION=
# Para manter o domínio Vercel com API permanente, configure na Vercel:
# API_UPSTREAM_ORIGIN=https://seu-backend.onrender.com
# API_PROXY_SECRET=mesmo-segredo-privado-na-vercel-e-no-backend
# Consulte docs/CONFIGURACAO-PUBLICA.md para produtos, webhook e portal do cliente.
# Omit DATABASE_URL for the embedded persistent PostgreSQL-compatible local engine.
# Produção atual: Firestore Standard, acessado somente pelo servidor.
# DATABASE_PROVIDER=firestore
# FIREBASE_PROJECT_ID=curriculoautomatico-a15fa
# GCP_WORKLOAD_IDENTITY_AUDIENCE=//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# GCP_SERVICE_ACCOUNT_EMAIL=SERVICE_ACCOUNT_EMAIL
# Desenvolvimento Firestore: ADC local ou FIRESTORE_EMULATOR_HOST=127.0.0.1:8080.
# PostgreSQL continua disponível como alternativa local; workers Redis são opcionais.
# DATABASE_URL=postgres://orbita:change-me@localhost:5432/orbita
# REDIS_URL=redis://localhost:6379
DATA_DIR=.data
# Native candidate sessions use a headless Chromium browser on the API and worker.
# Install: npx playwright install --with-deps chromium
# API and workers must share DATA_DIR and ENCRYPTION_KEY for resumes and encrypted sessions.
# Run Linux services as an unprivileged user with browser sandbox support.
PORTAL_CONNECTIONS_ENABLED=true
# Opcional: caminho absoluto de um Chromium/Chrome compatível instalado no servidor.
# PORTAL_BROWSER_EXECUTABLE_PATH=
# Enable only providers with explicit permission from the service for browser access.
# A candidate's consent alone does not grant that permission. Default: none.
PORTAL_BROWSER_AUTHORIZED=
# Navegador remoto privado por pessoa e portal; LinkedIn excluído.
# PORTAL_CLOUD_ENABLED=true
# PORTAL_CLOUD_OWNER_ID=  # Vazio usa ANTIGRAVITY_OWNER_ID.
# PORTAL_CLOUD_ALL_USERS=false  # true libera para todas as contas autenticadas.
# PORTAL_CLOUD_SNAPSHOT_ID=
# PORTAL_CLOUD_PORTALS=gupy,infojobs,glassdoor
# Veja docs/ENVIOS-NA-NUVEM.md.
# LinkedIn public-page automation also requires provider authorization.
PORTAL_DISCOVERY_AUTHORIZED=
# Official LinkedIn OpenID Connect: identity only, no job/application permission.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:5173/api/oauth/linkedin/callback
# Optional official InfoJobs.net connector (Spain only, separate from Brazil).
INFOJOBS_ES_CLIENT_ID=
INFOJOBS_ES_CLIENT_SECRET=
INFOJOBS_ES_REDIRECT_URI=http://127.0.0.1:5173/api/oauth/infojobs-es/callback
PORTAL_LOGIN_LIMIT=4
# Encryption master key: optional base64 32 bytes. Otherwise .data/encryption.key is generated.
# Keep this key private and back it up independently from the database.
# ENCRYPTION_KEY=
# Na Vercel, banco persistente (Firestore ou PostgreSQL) e ENCRYPTION_KEY fixa são obrigatórios.
# Instruções de publicação: docs/VERCEL-E-GOOGLE.md
# Ollama endpoint is configured only on the server, never by arbitrary frontend URLs.
# OLLAMA_URL=http://127.0.0.1:11434
# Optional authorized employer-controlled application adapter (never portal passwords).
# APPLICATION_WEBHOOK_URL=https://your-authorized-service.example/applications
# APPLICATION_WEBHOOK_TOKEN=
# APPLICATION_WEBHOOK_AUTHORIZED=true
# APPLICATION_WEBHOOK_PORTALS=linkedin,gupy,glassdoor,infojobs
# Declare only portals the authorized service can submit to on behalf of connected users.
# Each request includes workspaceId, portal and the approved original resume file as base64.
# Adapter must accept Idempotency-Key and return { status: "sent", receipt: "..." }.

# Gemini: server-only credential, never VITE_* or source code.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Antigravity CLI com login Google: execução remota em Vercel Sandbox.
# Habilite somente para o titular da conta Google; não compartilha a cota com outros usuários.
# ANTIGRAVITY_ENABLED=true
# ANTIGRAVITY_OWNER_ID=
# ANTIGRAVITY_SANDBOX_NAME=empregatos-antigravity
# ANTIGRAVITY_SEARCH_MODEL=   # Vazio seleciona Gemini Flash Low do catálogo oficial do CLI.
# Consulte docs/ANTIGRAVITY-NA-VERCEL.md. Créditos extras estão desativados.
# Each user must opt in to external analysis in Settings; local analysis remains available.

# Optional Adzuna. Enable only countries covered by your valid API license.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=br
# ADZUNA_ALLOWED_COUNTRIES=br
## Vercel: proteção da rotina diária (segredo do servidor, nunca VITE_*).
CRON_SECRET=
VERCEL_QUEUES_ENABLED=true

# Catálogo de organizações com quadro público verificado. Não contém contas de candidatos.
# Exemplo de formato: [{"type":"greenhouse","company":"Nome confirmado","board":"identificador-publicado"}]
DISCOVERY_ATS_BOARDS=[]
# Páginas oficiais com formulários WP Jobs Board reconhecidos; datas vêm do anúncio.
# Exemplo: [{"company":"Empresa","url":"https://empresa.com.br/jobs/"}]
DISCOVERY_COMPANY_BOARDS=[]
# Hosts exatos habilitados para envio pelo formulário nativo, sem navegador/login.
COMPANY_FORM_AUTHORIZED=
# Catálogo público Abler: confirma no anúncio o e-mail individual e a data real.
ABLER_EMAIL_DISCOVERY_ENABLED=false
# Autorização de automação por quadro/empresa, concedida pelo responsável do destino.
# Exemplo de formato: greenhouse:quadro,lever:quadro,ashby:quadro,company:carreiras.empresa.com
# Não preencher com '*' nem com credenciais de candidatos. Público não significa autorizado para envio.
ATS_BROWSER_AUTHORIZED=
# Formulários públicos suportados, sem conta de candidato nem API privada.
# Habilitação explícita pelo operador; respeite as condições dos destinos.
# Somente estes nomes são aceitos; '*' e domínios arbitrários não habilitam nada.
ATS_PUBLIC_FORM_PLATFORMS=
# Exemplo: greenhouse,lever,ashby,smartrecruiters
# Busca direta por anúncios oficiais citados e confirmados na página da empresa.
# Reutiliza o mecanismo de pesquisa configurado; não envia o currículo para pesquisar.
OFFICIAL_CAREERS_DISCOVERY_ENABLED=true
# Desenvolvimento somente; na Vercel o navegador sempre usa Sandbox efêmero.
ATS_EXECUTION_LOCAL=false
# Orçamento de pesquisa por conta/dia, limitado também a 4 vezes o limite de envio.
# As tarefas resolvem até 4 vagas e continuam em outra tarefa dentro desse orçamento.
DESTINATION_RESEARCH_DAILY_LIMIT=20
# Bounded automatic research and persisted discovery windows; preferences are unchanged.
DESTINATION_RESEARCH_AUTOMATIC_DAILY_LIMIT=200
AUTOMATIC_DISCOVERY_CONTINUATION_LIMIT=4
ABLER_DISCOVERY_BATCH_SIZE=120
COMPANY_DISCOVERY_PAGE_LIMIT=4
COMPANY_DISCOVERY_BATCH_SIZE=60
AUTOMATIC_SUBMISSION_BATCH_SIZE=20
# A consulta detalhada SmartRecruiters tem orçamento por quadro, sem presumir fechamento por ausência.
SMARTRECRUITERS_MAX_POSTINGS=30
# Jooble Brasil exige chave regional e condições de uso aplicáveis.
# JOOBLE_API_KEY=
# Optional verified Quickin boards. Browser submission additionally requires an
# exact ATS_BROWSER_AUTHORIZED grant such as quickin:globalti.
DISCOVERY_QUICKIN_BOARDS=[]
