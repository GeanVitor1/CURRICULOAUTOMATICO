.git/
# The build's secret check reads the repository's environment ignore rules.
!.gitignore
.vercel/
.agents/
skills-lock.json
node_modules/
.data/
.sites-runtime/
.env
.env.*
!.env.example
google-client.local.json
**/client_secret*.json
**/*.pem
**/*.key
artifacts/
test-results/
playwright-report/
coverage/
**/*.log
